<UserControl x:Class="DriveSpaceAnalyzer.App.ResultsPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding Context}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#52627A"/>
  <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,6"
   Visibility="{Binding Loading, Converter={StaticResource BoolVisibility}}"/>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="260"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="260"/></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="5">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="14,12,14,8">
      <TextBlock Text="Folders by Size" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding FolderHint}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,3,0,0"/>
     </StackPanel>
     <TextBox Grid.Row="1" Text="{Binding FolderSearch, UpdateSourceTrigger=PropertyChanged}" Margin="12,0,12,10"
      AutomationProperties.Name="Search folders by name or full path" ToolTip="Search folders by name or full path"/>
     <DataGrid x:Name="FoldersGrid" Grid.Row="2" ItemsSource="{Binding FolderView}" MouseDoubleClick="FolderDoubleClick"
      AutomationProperties.Name="Folders by size" RowDetailsVisibilityMode="Collapsed">
      <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Quality}"/></Style></DataGrid.RowStyle>
      <DataGrid.Columns>
       <DataGridTextColumn Header="Folder Name" Binding="{Binding Name}" SortMemberPath="Name" Width="160"/>
       <DataGridTextColumn Header="Total Size" Binding="{Binding TotalBytes, Converter={StaticResource Size}}" SortMemberPath="TotalBytes" SortDirection="Descending" Width="110"/>
       <DataGridTextColumn Header="File Count" Binding="{Binding FileCount, StringFormat=N0}" SortMemberPath="FileCount" Width="100"/>
       <DataGridTextColumn Header="Folder Count" Binding="{Binding FolderCount, StringFormat=N0}" SortMemberPath="FolderCount" Width="110"/>
       <DataGridTextColumn Header="Full Path" Binding="{Binding FullPath}" SortMemberPath="FullPath" Width="300"/>
       <DataGridTextColumn Header="Completeness" Binding="{Binding Quality}" SortMemberPath="IsIncomplete" Width="260"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#D7DFEB"
    ToolTip="Drag to resize the panels" AutomationProperties.Name="Resize results panels"/>
   <Border Grid.Column="2" Background="White" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="5">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="14,12,14,8">
      <TextBlock Text="Large Files" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding FileHint}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,3,0,0"/>
     </StackPanel>
     <TextBox Grid.Row="1" Text="{Binding FileSearch, UpdateSourceTrigger=PropertyChanged}" Margin="12,0,12,10"
      ToolTip="Search files by name or full path" AutomationProperties.Name="Search files by name or full path"/>
     <DataGrid x:Name="FilesGrid" Grid.Row="2" ItemsSource="{Binding FileView}" AutomationProperties.Name="Large files">
      <DataGrid.Columns>
       <DataGridTextColumn Header="File Name" Binding="{Binding Name}" SortMemberPath="Name" Width="200"/>
       <DataGridTextColumn Header="File Size" Binding="{Binding SizeBytes, Converter={StaticResource Size}}" SortMemberPath="SizeBytes" SortDirection="Descending" Width="110"/>
       <DataGridTextColumn Header="Extension" Binding="{Binding Extension}" SortMemberPath="Extension" Width="85"/>
       <DataGridTextColumn Header="Full Path" Binding="{Binding FullPath}" SortMemberPath="FullPath" Width="350"/>
       <DataGridTextColumn Header="Modified (local)" Binding="{Binding ModifiedLocal, StringFormat=yyyy-MM-dd HH:mm:ss}" SortMemberPath="ModifiedUtc" Width="170"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
