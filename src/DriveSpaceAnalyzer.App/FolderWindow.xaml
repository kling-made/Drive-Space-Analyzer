<Window x:Class="DriveSpaceAnalyzer.App.FolderWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:DriveSpaceAnalyzer.App"
 Width="1200" Height="760" MinWidth="800" MinHeight="500" Loaded="WindowLoaded" Closed="WindowClosed">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,14">
   <Button DockPanel.Dock="Right" Content="Copy Path" Click="CopyPathClick" VerticalAlignment="Center" Margin="10,0,0,0"/>
   <StackPanel>
    <TextBlock Text="Folder contents" FontSize="24" FontWeight="SemiBold"/>
    <TextBlock x:Name="PathLabel" TextWrapping="Wrap" Foreground="#52627A" Margin="0,5,0,0"/>
   </StackPanel>
  </DockPanel>
  <local:ResultsPanel Grid.Row="1"/>
  <TextBlock x:Name="Footer" Grid.Row="2" Text="Read-only snapshot. Folder sizes include descendants; files are shown recursively. No rescan occurs." TextWrapping="Wrap" Foreground="#64748B" Margin="0,12,0,0"/>
 </Grid>
</Window>
