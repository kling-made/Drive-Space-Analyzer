<Window x:Class="DriveSpaceAnalyzer.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:DriveSpaceAnalyzer.App"
 Title="Drive Space Analyzer" Width="1400" Height="850" MinWidth="1000" MinHeight="680"
 Loaded="WindowLoaded" Closing="WindowClosing" Closed="WindowClosed">
 <Grid Margin="20,16,20,12">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,14">
   <Border DockPanel.Dock="Right" Background="#E4ECFF" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
    <TextBlock Text="READ-ONLY  ·  OFFLINE" Foreground="#2458D3" FontWeight="SemiBold" FontSize="11"/>
   </Border>
   <StackPanel>
    <TextBlock Text="Drive Space Analyzer" FontSize="28" FontWeight="SemiBold"/>
    <TextBlock Text="Understand where your space goes. Explore folders and find large files." Foreground="#64748B" Margin="0,3,0,0"/>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="White" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid Margin="0,0,18,0" IsEnabled="{Binding CanConfigure}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,16,0">
      <TextBlock Text="Logical drive" FontWeight="SemiBold" Margin="0,0,0,5"/>
      <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" DisplayMemberPath="Description"
       AutomationProperties.Name="Logical drive"/>
     </StackPanel>
     <StackPanel Grid.Column="1">
      <TextBlock Text="Minimum file size (strictly greater than)" FontWeight="SemiBold" Margin="0,0,0,5"/>
      <StackPanel Orientation="Horizontal">
       <TextBox Text="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}" Width="95" Margin="0,0,6,0" AutomationProperties.Name="Minimum file size"/>
       <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" Width="68" AutomationProperties.Name="File size unit"/>
      </StackPanel>
     </StackPanel>
    </Grid>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
     <Button Content="Scan Drive" Command="{Binding ScanCommand}" Background="#2458D3" Foreground="White" BorderBrush="#2458D3" FontWeight="SemiBold"/>
     <Button Content="Cancel Scan" Command="{Binding CancelCommand}"/>
     <Button Content="Refresh Drives" Command="{Binding RefreshCommand}" Margin="0"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
     <TextBlock Text="{Binding DriveDetails}" Foreground="#52627A" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding Validation}" Foreground="#B42318" TextWrapping="Wrap"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="2" Background="#EAF0FC" CornerRadius="5" Padding="12,9" Margin="0,0,0,12">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel>
     <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
      <TextBlock Text="{Binding Elapsed}" Margin="15,0,15,0" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Remaining}"/>
     </StackPanel>
     <TextBlock Text="{Binding Phase}" FontWeight="SemiBold"/>
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,7,0,6">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ProgressBar Value="{Binding Percent}" IsIndeterminate="{Binding Indeterminate}" Height="7" VerticalAlignment="Center" Foreground="#2458D3"/>
     <TextBlock Grid.Column="1" Text="{Binding Percentage}" Margin="12,0,0,0" Foreground="#52627A"/>
    </Grid>
    <TextBlock Grid.Row="2" Text="{Binding CurrentDirectory}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentDirectory}"/>
    <DockPanel Grid.Row="3" Margin="0,4,0,0">
     <TextBlock DockPanel.Dock="Right" Text="{Binding ScannedBytes}" Foreground="#52627A"/>
     <TextBlock Text="{Binding Counters}" Foreground="#52627A"/>
    </DockPanel>
   </Grid>
  </Border>
  <local:ResultsPanel Grid.Row="3" DataContext="{Binding Results}"/>
  <Expander Grid.Row="4" Header="Scan summary and skipped items" Margin="0,8,0,4">
   <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="8">
     <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding Issues}" TextWrapping="Wrap" Foreground="#8C4A16" Margin="0,8,0,0"/>
    </StackPanel>
   </ScrollViewer>
  </Expander>
  <StackPanel Grid.Row="5">
   <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
   <TextBlock Text="Logical sizes use decimal units and can differ from physical allocation (compression, sparse files, hard links and overhead). Folder totals include descendants; do not add them together." Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
  </StackPanel>
 </Grid>
</Window>
